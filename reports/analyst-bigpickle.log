import re
paths=set()
methods={}
with open('sos-openapi.yml') as f:
    lines=f.readlines()
cur=None
for ln in lines:
    m=re.match(r'^  /([^ ].*):$', ln)
    if m:
        cur=m.group(1)
        paths.add(cur)
    else:
        m2=re.match(r'^    (get|post|put|patch|delete|head|options):', ln)
        if m2 and cur:
            methods.setdefault(cur,[]).append(m2.group(1))
print('total paths:', len(paths))
for p in sorted(paths):
    print(p, ','.join(sorted(methods.get(p,[]))))
