import yaml, re
from collections import defaultdict
spec = yaml.safe_load(open('openapi.yml'))
paths = spec['paths']

account_only, org_only, both = [], [], []
orgpath = []
for p, ops in paths.items():
    if '{' in p:
        # capture param names in path
        params = re.findall(r'\{([^}]+)\}', p)
        if any('rganization' in x or 'ompany' in x for x in params):
            orgpath.append((p, params))
    for m, op in ops.items():
        if m not in ('get','post','put','patch','delete','head','options'): continue
        sec = op.get('security', [{'XAuthOrganization':[]},{'XAuthAccount':[]}])
        names = [list(s.keys())[0] for s in sec if s]
        if names == ['XAuthAccount']: account_only.append((m.upper(), p))
        elif names == ['XAuthOrganization']: org_only.append((m.upper(), p))
        elif 'XAuthAccount' in names and 'XAuthOrganization' in names: both.append((m.upper(), p))

print("=== ACCOUNT-ONLY (%d) ===" % len(account_only))
for m,p in account_only: print(f"  {m} {p}")
print("=== ORG-ONLY (%d) ===" % len(org_only))
for m,p in org_only: print(f"  {m} {p}")
print("=== PATHS WITH ORG/COMPANY IN PATH (%d) ===" % len(orgpath))
for p,pars in orgpath: print("  ", p, pars)
