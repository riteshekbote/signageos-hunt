import yaml, json
spec = yaml.safe_load(open('openapi.yml'))
paths = spec['paths']
def resolve(ref, spec, _d=0):
    if not isinstance(ref,str) or not ref.startswith('#'): return ref
    parts = ref.lstrip('#/').split('/')
    node = spec
    for p in parts: node = node[p]
    return node

def schema_of(s, spec, depth=0):
    if not isinstance(s, dict): return s
    if '$ref' in s: return schema_of(resolve(s['$ref'],spec), spec, depth+1)
    if depth>3: return '(deep)'
    return {k: schema_of(v,spec,depth+1) for k,v in s.items()}

def dump_op(p,m,op,spec):
    print(f"### {m.upper()} {p}")
    print("  summary:", op.get('summary'))
    params = op.get('parameters', [])
    for prm in params:
        if isinstance(prm, dict) and ('$ref' in prm or 'name' in prm):
            prm = resolve(prm.get('$ref'),spec) if '$ref' in prm else prm
            print(f"  param: {prm.get('name')} in={prm.get('in')} req={prm.get('required')} desc={str(prm.get('description'))[:120]}")
    resp = op.get('responses',{}).get('200',{})
    cont = resp.get('content',{})
    if cont:
        for ct, v in cont.items():
            sch = schema_of(v.get('schema',{}), spec)
            print(f"  200/{ct} schema: {json.dumps(sch)[:600]}")

dump_op('/v1/organization/{organizationUid}','get', paths['/v1/organization/{organizationUid}']['get'], spec)
dump_op('/v1/organization/{organizationUID}/security-token','get', paths['/v1/organization/{organizationUID}/security-token']['get'], spec)
dump_op('/v1/organization/{organizationUID}/security-token','post', paths['/v1/organization/{organizationUID}/security-token']['post'], spec)
dump_op('/v1/company/{companyUid}','get', paths['/v1/company/{companyUid}']['get'], spec)
dump_op('/v1/account/security-token','post', paths['/v1/account/security-token']['post'], spec)
