import yaml
spec = yaml.safe_load(open('sos-openapi.yml'))
paths = spec['paths']
methods = ('get','post','put','patch','delete')
unauth = []
for p, item in sorted(paths.items()):
    for m in methods:
        op = item.get(m)
        if not op: continue
        # operation-level security overrides
        sec = op.get('security')
        # resolve refs inside security? security may contain {'$ref'...} unlikely
        if sec == []:
            unauth.append((m.upper(), p, op.get('summary','')))
        elif sec and all(isinstance(x, dict) for x in sec):
            flat = [list(x.keys()) for x in sec]
            if any(k not in ('XAuthOrganization','XAuthAccount') for s in flat for k in s):
                unauth.append((m.upper(), p, op.get('summary','')+f" SEC={flat}"))
print("=== OPERATIONS WITH security:[] or unknown schemes ===")
for row in unauth: print(row)
print(f"\nTOTAL: {len(unauth)}")
