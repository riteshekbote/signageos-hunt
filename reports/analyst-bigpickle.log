				type: 'text',
				name: 'inputAuth0ClientId',
				message: 'Auth0 client ID',
				initial: process.env.SOS_AUTH0_CLIENT_ID ?? process.env.SOS_DEFAULT_AUTH0_CLIENT_ID ?? '',
