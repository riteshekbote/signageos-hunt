Let me re-probe with raw multi-header capture (the dict-based read collapsed duplicate `Access-Control-Allow-Origin` headers, which the KB claims numbered 17-18 on box).
[0m$ [0mcd /home/runner/work/signageos-hunt/signageos-hunt && python3 - <<'PY'
import urllib.request, time

endpoints = [
    ("box.status (no-origin)",  "https://box.signageos.io/status",          None, "GET"),
    ("box.status (evil.test)",   "https://box.signageos.io/status",          "https://evil.test", "GET"),
    ("box.root  (no-origin)",    "https://box.signageos.io/",                None, "GET"),
    ("box.root  (evil.test)",    "https://box.signageos.io/",                "https://evil.test", "GET"),
    ("box.login (no-origin)",    "https://box.signageos.io/login/",          None, "GET"),
    ("box.login (evil.test)",    "https://box.signageos.io/login/",          "https://evil.test", "GET"),
    ("box.login (zdinternal)",   "https://box.signageos.io/login/",          "https://api.signageos.io", "GET"),
    ("api.status(no-origin)",    "https://api.signageos.io/status",          None, "GET"),
    ("api.status(evil.test)",    "https://api.signageos.io/status",          "https://evil.test", "GET"),
    ("api.root  (evil.test)",    "https://api.signageos.io/",                "https://evil.test", "GET"),
]

def hdrs(resp):
    # multi-value capture using email.message semantics
    out = []
    for k,v in resp.headers.items():
        out.append((k, v))
    return out, resp.headers

for tag,url,origin,method in endpoints:
    req=urllib.request.Request(url, method=method)
    req.add_header("User-Agent","bigpickle-raw-reccon/1.0")
    if origin: req.add_header("Origin",origin)
    try:
        r=urllib.request.urlopen(req,timeout=20)
        code=r.status
        raw,_=hdrs(r)
        acao_all=[v for k,v in raw if k.lower()=='access-control-allow-origin']
        acallowcred=[v for k,v in raw if k.lower()=='access-control-allow-credentials']
        csp=[v for k,v in raw if k.lower()=='content-security-policy']
        hsts=[v for k,v in raw if k.lower()=='strict-transport-security']
        xfo=[v for k,v in raw if k.lower()=='x-frame-options']
        xcto=[v for k,v in raw if k.lower()=='x-content-type-options']
        vary=[v for k,v in raw if k.lower()=='vary']
        body=r.read(2000).decode('utf-8','replace')
        print(f"\n=== {tag} :: {method} {url} [Origin={origin}] -> HTTP {code}")
        print(f"  ACAO count={len(acao_all)} values={acao_all}")
        print(f"  ACAC={acallowcred if acallowcred else 'none'}")
        print(f"  HSTS={hsts if hsts else 'none'} | XFO={xfo if xfo else 'none'} | XCTO={xcto if xcto else 'none'} | VARY={vary if vary else 'none'}")
        if csp:
            c=csp[0]
            # count distinct https origins in connect-src
            import re
            cs=re.search(r'connect-src(.*?);',c)
            origins=re.findall(r'https?://[a-z0-9._*-]+(?:\.[a-z0-9._*-]+)*', cs.group(1) if cs else '')
            uniq=sorted(set(origins))
            print(f"  CSP total len={len(c)} | connect-src distinct origins={len(uniq)} | sample={uniq[:8]}")
        else:
            print(f"  CSP: none")
        print(f"  body(180)={body[:180]!r}")
    except Exception as e:
        print(f"\n=== {tag} :: ERR {e}")
    time.sleep(1.1)
