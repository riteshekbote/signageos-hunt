import urllib.request, urllib.error, json, time, ssl

hosts = [
    ("box/status", "https://box.signageos.io/status", "GET"),
    ("box/root", "https://box.signageos.io/", "GET"),
    ("box/login", "https://box.signageos.io/login/", "GET"),
    ("box/ready", "https://box.signageos.io/ready", "GET"),
    ("box/csp-report", "https://box.signageos.io/csp-report", "GET"),
    ("api/status", "https://api.signageos.io/status", "GET"),
    ("api/root", "https://api.signageos.io/", "GET"),
]

def probe(tag, url, method, origin=None):
    req = urllib.request.Request(url, method=method)
    if origin: req.add_header("Origin", origin)
    req.add_header("User-Agent", "bigpickle-passive-reccon/1.0")
    try:
        t0=time.time()
        resp = urllib.request.urlopen(req, timeout=20)
        dt=time.time()-t0
        body = resp.read(6000)
        hdrs = dict(resp.headers.items())
        print(f"\n### {tag} :: {method} {url} [Origin={origin}]")
        print(f"status={resp.status} len={len(body)} ct={hdrs.get('Content-Type','?')} dt={dt:.2f}s")
        # security headers grep
        seckeys=['strict-transport-security','x-frame-options','x-content-type-options','content-security-policy','referrer-policy','access-control-allow-origin','access-control-allow-credentials']
        sec=[f"{k}: {hdrs.get(k,'-')}" for k in seckeys if k in {kk.lower() for kk in hdrs}]
        print("headers-of-interest:")
        for s in sec: print("  ", s)
        # count ACAO lines
        acao = [k for k in hdrs if k.lower()=='access-control-allow-origin']
        print(f"ACAO count={len(acao)} values={acao if acao else 'n/a'}")
        csp = hdrs.get('Content-Security-Policy', hdrs.get('content-security-policy',''))
        if csp:
            import re
            # count distinct origins in connect-src and frame-src
            print(f"CSP len={len(csp)} (truncated to 400 chars):")
            print("  ", csp[:400])
        # body preview
        bstr = body.decode('utf-8','replace')
        print("body preview:")
        for line in bstr.splitlines()[:12]:
            print("  ", line[:200])
        return resp.status, hdrs, body
    except urllib.error.HTTPError as e:
        hdrs=dict(e.headers.items())
        body=e.read(2000)
        print(f"\n### {tag} :: {method} {url} [Origin={origin}] -> HTTPError {e.code}")
        seckeys=['content-security-policy','access-control-allow-origin','access-control-allow-credentials','vary']
        for k in seckeys:
            if k in {kk.lower() for kk in hdrs}: print("  ", f"{k}: {hdrs.get(k)}", )
        try: json.dumps(json.loads(body),indent=2)[:600]
        except: pass
        print("body:", body.decode('utf-8','replace')[:300])
        return e.code, hdrs, body
    except Exception as e:
        print(f"\n### {tag} :: {method} {url} -> ERR {e}")
        return None, {}, b''

for tag,url,m in hosts:
    probe(tag,url,m)
    # second pass with spoofed origin for status/login/root to test CORS reflection
    if 'box' in tag and ('status' in tag or 'login' in tag or tag.endswith('root') or 'login' in tag):
        probe(tag+"+evil-origin", url, m, origin="https://evil.test")
    time.sleep(1.1)
