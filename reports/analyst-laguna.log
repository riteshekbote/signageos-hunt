import urllib.request, time, json

# DELTA candidates: alternate health/metrics/version paths on box
candidates = [
    "https://box.signageos.io/health",
    "https://box.signageos.io/healthz",
    "https://box.signageos.io/metrics",
    "https://box.signageos.io/version",
    "https://box.signageos.io/build",
    "https://box.signageos.io/env",
    "https://box.signageos.io/api",
    "https://box.signageos.io/debug",
    "https://box.signageos.io/.env",
    "https://box.signageos.io/package.json",
    "https://box.signageos.io/bundle.js",
]
def probe(url):
    req=urllib.request.Request(url, method="GET")
    req.add_header("User-Agent","bigpickle-delta/1.0")
    try:
        r=urllib.request.urlopen(req,timeout=15)
        b=r.read(2000).decode('utf-8','replace')
        ct=dict(r.headers.items()).get('Content-Type','-')
        print(f"{url} -> {r.status} ct={ct} len={len(b)}")
        if r.status==200 and ('json' in ct or b.strip().startswith('{')):
            print("   BODY:", b[:300])
    except urllib.error.HTTPError as e:
        print(f"{url} -> {e.code}")
        b=e.read(400).decode('utf-8','replace')
        if b.strip().startswith('{'): print("   BODY:", b[:300])
    except Exception as e:
        print(f"{url} -> ERR {type(e).__name__}")
    time.sleep(1.1)

for u in candidates:
    probe(u)

# Archive canonical /status PoC evidence
import shutil
req=urllib.request.Request("https://box.signageos.io/status", method="GET")
req.add_header("User-Agent","bigpickle-poc/1.0")
r=urllib.request.urlopen(req,timeout=20)
hdr='/tmp/poc_box_status_bigpickle_H.txt'
body='/tmp/poc_box_status_bigpickle_B.json'
open(hdr,'wb').write(r.headers.as_bytes())
open(body,'wb').write(r.read())
print("\n# ARCHIVED PoC evidence:")
print(f"  headers -> {hdr}")
print(f"  body    -> {body}")
# parse body fields
data=json.loads(open(body).read())
print("  body json keys:", list(data.keys()))
print("  process keys:", list(data.get('process',{}).keys()))
print("  succeededServices:", data.get('succeededServices'))
print("  headers in file:", len(open(hdr).read().splitlines()))
